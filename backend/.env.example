# Environment Variables — Backend
# Copy this file to .env and fill in your values. Never commit .env to git.

# MongoDB connection string
# Local example: mongodb://localhost:27017/car-dealership
# Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/car-dealership
MONGO_URI=mongodb://localhost:27017/car-dealership

# JWT secret — use a long, random string in production
JWT_SECRET=replace_this_with_a_strong_secret_key

# JWT expiry duration (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# Server port
PORT=5000
